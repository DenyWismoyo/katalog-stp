# ============================================================================
# ENVIRONMENT VARIABLES - KATALOG DIGITAL STP (SOLO TECHNOPARK)
# Salin berkas ini ke .env.local dan isi kredensial resmi Firebase Anda
# ============================================================================

# --- Firebase Client SDK (Client-side Safe) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=teknopark-surakarta.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=teknopark-surakarta
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=teknopark-surakarta.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_ID=(default)

# --- Firebase Admin SDK (Server-Only, Confidential) ---
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@teknopark-surakarta.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- App Config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Katalog Digital Solo Technopark"
